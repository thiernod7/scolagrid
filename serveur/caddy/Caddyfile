# Caddy est la seule porte d'entrée du serveur, partagée par les deux environnements.
# Il obtient et renouvelle les certificats HTTPS tout seul.

# Version web de l'app (onboarding, puis suivi en ligne) et téléchargements.
(site_web) {
	encode zstd gzip
	@entree path / /index.html /flutter_service_worker.js /version.json
	header @entree Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

app.{$SCOLAGRID_HOST} {
	root * /srv/web/prod
	import site_web
}
app-essai.{$SCOLAGRID_HOST} {
	root * /srv/web/essai
	import site_web
}

# Production
api.{$SCOLAGRID_HOST} {
	reverse_proxy api-gw-prod:8000
}
sync.{$SCOLAGRID_HOST} {
	reverse_proxy powersync-prod:8080 {
		flush_interval -1
	}
}

# Essai
api-essai.{$SCOLAGRID_HOST} {
	reverse_proxy api-gw-essai:8000
}
sync-essai.{$SCOLAGRID_HOST} {
	reverse_proxy powersync-essai:8080 {
		flush_interval -1
	}
}
